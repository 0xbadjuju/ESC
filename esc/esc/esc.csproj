<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Allow building as either EXE (default) or Library via BuildAsLibrary property -->
    <TargetFramework>net461</TargetFramework>
    <AssemblyName>esc</AssemblyName>
    <RootNamespace>esc</RootNamespace>
    <LangVersion>latest</LangVersion>
    
    <!-- Default to Exe, but allow override via BuildAsLibrary property -->
    <OutputType Condition="'$(BuildAsLibrary)' != 'true'">Exe</OutputType>
    <OutputType Condition="'$(BuildAsLibrary)' == 'true'">Library</OutputType>
    
    <!-- NuGet Package Metadata -->
    <PackageId>EvilSQLClient</PackageId>
    <Version>1.0.0</Version>
    <Authors>Scott Sutherland (@_nullbind), NetSPI</Authors>
    <Company>NetSPI</Company>
    <Description>Evil SQL Client (ESC) is an interactive .NET SQL console client with enhanced server discovery, access, and data exfiltration features. Built for use during penetration testing and red team engagements.</Description>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageTags>sql;security;pentesting;redteam</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Build" />
    <Reference Include="Microsoft.Build.Framework" />
    <Reference Include="Microsoft.Build.Utilities.v4.0" />
    <Reference Include="System.DirectoryServices" />
    <Reference Include="System.DirectoryServices.Protocols" />
  </ItemGroup>

</Project>
